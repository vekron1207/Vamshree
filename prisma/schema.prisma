// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  tagline      String?
  description  String?   @db.Text
  imageUrl     String?
  sortOrder    Int       @default(0)
  isVisible    Boolean   @default(true)
  // Collection-wide sale: applies a percentage off to every product in this
  // collection only, optionally limited to a date window.
  saleEnabled  Boolean   @default(false)
  salePercent  Int       @default(0)
  saleLabel    String?
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Editable storefront content (About Us, Contact Us). `body` is plain text;
// blank lines separate paragraphs. `details` holds page-specific fields.
model SitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  intro     String?  @db.Text
  body      String?  @db.Text
  imageUrl  String?
  details   Json?
  updatedAt DateTime @updatedAt
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String?        @db.Text
  price          Decimal        @db.Decimal(10, 2)
  compareAtPrice Decimal?       @db.Decimal(10, 2)
  sku            String?        @unique
  stock          Int            @default(0)
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  collectionId   String?
  collection     Collection?    @relation(fields: [collectionId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String?
  addresses    Address[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String   @default("")
  isDefault  Boolean  @default(false)
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  shippingAddress   Json
  items             OrderItem[]
  subtotal          Decimal     @db.Decimal(10, 2)
  shippingFee       Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  discountCode      String?
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  // True while this order is holding stock (reserved at checkout, released on
  // cancel/expiry). Prevents releasing or reserving the same stock twice.
  stockHeld         Boolean     @default(false)
  isGift            Boolean     @default(false)
  giftMessage       String?     @db.Text
  courier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippedAt         DateTime?
  adminNote         String?     @db.Text
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([customerId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  variantId     String?
  variantLabel  String?
  nameSnapshot  String
  priceSnapshot Decimal  @db.Decimal(10, 2)
  quantity     Int

  @@index([orderId])
  @@index([productId])
}

enum AdminRole {
  OWNER
  STAFF
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
}

// A purchasable option of a product (e.g. ring size 14). When a product has
// variants, stock is tracked per variant and Product.stock mirrors the total.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sku       String?
  stock     Int     @default(0)
  position  Int     @default(0)

  @@unique([productId, label])
  @@index([productId])
}

enum DiscountKind {
  PERCENT
  FLAT
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  kind        DiscountKind
  value       Int
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Store-wide settings (shipping rules, business/invoice details), one JSON row per key
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A question sent from the Contact page, answered by the owner later
model Enquiry {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String    @db.Text
  isReplied Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([isReplied, createdAt])
}
