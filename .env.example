# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string (Hostinger: Databases > MySQL Databases in hPanel)
DATABASE_URL="mysql://user:password@localhost:3306/vaamshri"

# Razorpay (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks > Secret for the webhook you create
RAZORPAY_WEBHOOK_SECRET=

# Session/auth secret for the admin panel - generate with: openssl rand -base64 32
SESSION_SECRET=

# Public base URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used once by `npm run db:seed` to create the first admin login
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


# Set to 1 on client preview deployments: tells search engines not to index the site
PREVIEW_MODE=

# Server time zone so order times show in India time
TZ=Asia/Kolkata

# Folder for admin-uploaded images. On Hostinger use a path outside the deployed app folder
# so uploads survive redeploys, e.g. /home/<user>/domains/<site>/shared-uploads
UPLOADS_DIR=

# Delhivery (track.delhivery.com API token): PIN code check at checkout and live parcel tracking
DELHIVERY_API_KEY=
